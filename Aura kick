local function makeSlider(yPos, label, min, max, default, suffix, onChange, step)
    step = step or 1
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -20, 0, 32)
    holder.Position = UDim2.fromOffset(10, yPos)
    holder.BackgroundTransparency = 1
    holder.Parent = main

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 14)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. string.format("%.1f", default) .. (suffix or "")
    lbl.TextColor3 = Colors.Sub
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, 0, 0, 10)
    bar.Position = UDim2.fromOffset(0, 18)
    bar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = holder
    corner(bar, 5)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
    fill.BackgroundColor3 = Colors.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 5)

    local dragging = false
    local function update(input)
        local abs = bar.AbsolutePosition.X
        local size = bar.AbsoluteSize.X
        if size <= 0 then return end
        local pct = math.clamp((input.Position.X - abs) / size, 0, 1)
        fill.Size = UDim2.fromScale(pct, 1)
        local val = min + (max - min) * pct
        val = math.floor(val / step + 0.5) * step
        lbl.Text = label .. ": " .. string.format("%.1f", val) .. (suffix or "")
        onChange(val)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
end

