    end
end)

task.spawn(function()
    while true do
        task.wait(2)
        local ok, ping = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok then
            State.CurrentPing = ping
            if ping > 400 then
                State.LagMode = "Frozen"
                State.GlobalRateCap = 100
            elseif ping > 200 then
                State.LagMode = "Slow"
                State.GlobalRateCap = 220
            else
                State.LagMode = "Normal"
                State.GlobalRateCap = 350
            end
        end
    end
end)

local function computeOffset(slotIndex, total)
    if total <= 1 then return V3(0, Config.HeightOffset, 0) end
    local angle = (slotIndex - 1) / total * math.pi * 2
    return V3(
        math.cos(angle) * Config.CircleRadius,
        Config.HeightOffset,
        math.sin(angle) * Config.CircleRadius
    )
end

local function findSlot(target)
    for i = 1, #State.ActiveTargets do
        if State.ActiveTargets[i] == target then return i end
    end
    return nil
end

local function removeSlot(target)
    for i = #State.ActiveTargets, 1, -1 do
        if State.ActiveTargets[i] == target then
            table.remove(State.ActiveTargets, i)
            return
        end
    end
end

local function cleanupPlayer(hrp)
    if not hrp or not hrp.Parent then return end
    local bp = hrp:FindFirstChild("KickHoldBP")
    local bg = hrp:FindFirstChild("KickHoldBG")
    if bp then pcall(function() bp:Destroy() end) end
    if bg then pcall(function() bg:Destroy() end) end
    pcall(function() DestroyLine:FireServer(hrp) end)
end

local function addTarget(player)
    if player == LP or State.Targets[player] then return end
    if #State.ActiveTargets >= Config.MaxTargets then return end

    local tChar, tHRP, tHum = getChar(player)
    if not (tChar and tHRP and tHum) then return end
    if tHum.Health <= 0 then return end
    if tHRP:FindFirstChild("KickHoldBP") then return end

    local bp = Instance.new("BodyPosition")
    bp.Name     = "KickHoldBP"
    bp.MaxForce = V3(math.huge, math.huge, math.huge)
    bp.P           = Config.PullStrength
    bp.D           = 100
    bp.Position    = tHRP.Position
    bp.Parent      = tHRP

    local bg = Instance.new("BodyGyro")
    bg.Name      = "KickHoldBG"
    bg.MaxTorque = V3(math.huge, math.huge, math.huge)
    bg.P           = 50000
    bg.D           = 100
    bg.CFrame      = tHRP.CFrame
    bg.Parent      = tHRP

    pcall(function()
        for _, p in ipairs(tChar:QueryDescendants("BasePart")) do
            p.CanCollide = false
        end
    end)

    local idx = #State.ActiveTargets + 1
    local stagger = ((idx - 1) % 24) / 24 * Config.StaggerWindow

    State.Targets[player] = {
        BP           = bp,
        BG           = bg,
        HRP          = tHRP,
        NextSNO      = tick() + stagger,
        NextDestroy  = tick() + stagger + 0.06,
    }

    table.insert(State.ActiveTargets, player)
end

local function removeTarget(player)
    local state = State.Targets[player]
    if not state then return end

    if state.BP and state.BP.Parent then pcall(state.BP.Destroy, state.BP) end
    if state.BG and state.BG.Parent then pcall(state.BG.Destroy, state.BG) end
    if state.HRP and state.HRP.Parent then
        pcall(function() DestroyLine:FireServer(state.HRP) end)
    end

    State.Targets[player] = nil
    removeSlot(player)
end

local function updateTarget(player, state, lpHRP)
    local tChar, tHRP, tHum = getChar(player)
    if not (tChar and tHRP and tHum) then return false end
    if tHum.Health <= 0 then return false end

    local dist = mag(lpHRP, tHRP)
    if dist > Config.Range then return false end

    local slot = findSlot(player)
    if slot and state.BP.Parent then
        state.BP.Position = lpHRP.Position + computeOffset(slot, #State.ActiveTargets)
        if dist > 40 then
            state.BP.P = math.min(Config.PullStrength * 3, 500000)
        else
            state.BP.P = Config.PullStrength
        end
    end

    local now = tick()

    if now >= state.NextSNO then
        if canFire() then
            pcall(function() SNO:FireServer(tHRP, tHRP.CFrame) end)
            State.GlobalRateCnt += 1
        end
        state.NextSNO = now + Config.SNOInterval
    end

    if dist <= Config.KillRange and now >= state.NextDestroy then
        if canFire() then
            pcall(function() DestroyLine:FireServer(tHRP) end)
            State.GlobalRateCnt += 1
        end
        state.NextDestroy = now + Config.DestroyInterval
    end

    return true
end

local function startAura()
    if State.Running then return end
    State.Running = true

    task.spawn(function()
        while Config.Enabled do
            local _, lpHRP = getChar()

            if lpHRP then
                for p in pairs(State.Targets) do
                    local ch = p.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch and ch:FindFirstChild("Humanoid")
                    if not hrp or not hum or hum.Health <= 0 or not p.Parent then
                        removeTarget(p)
                    end
                end

                if #State.ActiveTargets < Config.MaxTargets then
                    local candidates = {}

                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LP and not State.Targets[p] then
                            local _, tHRP, tHum = getChar(p)
                            if tHRP and tHum and tHum.Health > 0 then
                                local d = mag(lpHRP, tHRP)
                                if d <= Config.Range then
                                    table.insert(candidates, { plr = p, dist = d })
                                end
                            end
                        end
                    end

                    table.sort(candidates, function(a, b) return a.dist < b.dist end)

                    for _, c in ipairs(candidates) do
                        if #State.ActiveTargets >= Config.MaxTargets then break end
                        addTarget(c.plr)
                    end
                end

                for p, state in pairs(State.Targets) do
                    if not updateTarget(p, state, lpHRP) then
                        if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
                            removeTarget(p)
                        end
                    end
                end
            end

            task.wait(Config.BaseInterval)
        end

        State.Running = false
    end)
end

local function stopAura()
    Config.Enabled = false
    State.Running = false

    for p in pairs(State.Targets) do
        removeTarget(p)
    end

    table.clear(State.Targets)
    table.clear(State.ActiveTargets)
end

