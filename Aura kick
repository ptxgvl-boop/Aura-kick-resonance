RunService.Heartbeat:Connect(function()
    local count = #State.ActiveTargets
    local txt

    if Config.Enabled then
        local circle = count >= 2 and "  ⭕" or ""
        txt = string.format("● ON   |  targets: %d/%d%s", count, Config.MaxTargets, circle)
    else
        txt = string.format("● OFF  |  targets: %d/%d", count, Config.MaxTargets)
    end

    if status.Text ~= txt then status.Text = txt end

    local pTxt = string.format("ping: %d ms  |  mode: %s  |  rate: %d/s",
        math.floor(State.CurrentPing), State.LagMode, State.GlobalRateCnt)
    if pingLabel.Text ~= pTxt then
        pingLabel.Text = pTxt
        if State.LagMode == "Frozen" then
            pingLabel.TextColor3 = Colors.Red
        elseif State.LagMode == "Slow" then
            pingLabel.TextColor3 = Colors.Orange
        else
            pingLabel.TextColor3 = Colors.Sub
        end
    end

    local info, col
    if count >= 20 then
        info = string.format("🔥 FULL SERVER MODE (%d targets)", count)
        col = Colors.Orange
    elseif State.LagMode == "Frozen" then
        info = "⚠ ปิงสูงมาก — ชะลออัตโนมัติ"
        col = Colors.Red
    elseif Config.Range > Config.KillRange then
        info = string.format("Range (%d) > Kill (%d): ดึงไม่ spam, kick ตอนใกล้", Config.Range, Config.KillRange)
        col = Colors.Sub
    else
        info = string.format("✓ Optimal (Range %d ≤ Kill %d)", Config.Range, Config.KillRange)
        col = Colors.Green
    end

    if infoLabel.Text ~= info then
        infoLabel.Text = info
        infoLabel.TextColor3 = col
    end
end)

